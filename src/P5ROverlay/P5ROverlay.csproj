<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>P5ROverlay</AssemblyName>
    <RootNamespace>P5ROverlay</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyTitle>P5R 五维人物好感面板</AssemblyTitle>
    <Product>冰寒石英制作</Product>
    <!-- exe 的 Win32 图标（资源管理器 / 任务栏 / 快捷方式都取这个） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同时内嵌一份，运行时用来设窗口和托盘图标（多尺寸，16px 那帧不会被拉糊） -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- Release 输出到 ASCII 目录名，bat 里才能用 %~dp0 安全拼接（中文路径在 cmd 下会乱码） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\P5RPanel\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

</Project>
